---
import Base from '../../layouts/Base.astro';
import Platzhalter from '../../components/Platzhalter.astro';
import { EINRICHTUNG } from '../../config/einrichtung';
import { DATENRESIDENZ } from '../../config/datenresidenz';
import { KONDITIONEN } from '../../config/preise';

/**
 * FAQ. Übernimmt die sechs Fragen der alten Seite — mit drei Korrekturen aus
 * dem Content-Audit:
 *
 *  - Die Datenschutz-Antwort ist aus der Datenschutzerklärung abgeleitet und
 *    nicht neu formuliert (C2). Dort steht bereits die zutreffende Fassung.
 *  - „72 % sprechen keine Nachricht auf einen Anrufbeantworter" ist raus —
 *    die Zahl hat keine Quelle (C4). Das Argument trägt auch ohne sie.
 *  - Die alte Antwort „Die meisten Anrufer merken keinen Unterschied" ist
 *    GESPERRT, nicht ersetzt. Sie widerspricht der Datenschutzerklärung, die
 *    in §11 eine Ansage zu Beginn jedes Gesprächs zusichert (EU AI Act
 *    Art. 50) — aber ob diese Ansage tatsächlich ausgeliefert wird, ist
 *    unbestätigt (C25); in den Prompt-Vorlagen liess sie sich nicht finden,
 *    und im Fahrplan steht der Anrufer-Hinweis als offener Launch-Blocker.
 *
 *    Eine umgedrehte Antwort („Ja, wir sagen es") wäre damit genauso
 *    ungedeckt wie die alte — nur in die andere Richtung. Bis zur Klärung
 *    steht hier deshalb ein Platzhalter statt einer Formulierung.
 *
 * Gesperrte Fragen werden ausserdem NICHT ins FAQPage-Schema aufgenommen.
 * Ein Platzhalter, der als acceptedAnswer in den Suchergebnissen landet, wäre
 * schlimmer als gar kein Schema.
 */
const FRAGEN = [
  {
    frage: 'Merken meine Kunden, dass eine KI drangeht?',
    gesperrt: {
      befund: 'C25',
      wartetAuf:
        'Bestätigung, dass der Hinweis zu Beginn des Gesprächs tatsächlich ausgeliefert wird (Datenschutzerklärung §11, EU AI Act Art. 50)',
    },
  },
  {
    frage: 'Funktioniert Voxera mit meiner bestehenden Nummer?',
    antwort:
      'Ja. Sie richten eine Rufweiterleitung auf Ihrem bestehenden Anschluss ein — Ihre Kunden wählen weiterhin die gewohnte Nummer. Voxera schaltet sich nur ein, wenn Sie nicht abnehmen, und Sie legen fest, wann das gilt: sofort, nach einer bestimmten Anzahl Klingelzeichen oder bei besetzt.',
  },
  {
    frage: 'Was passiert mit meinen Daten?',
    // Erster Absatz wortgleich aus src/config/datenresidenz.ts, damit Hero-Badge,
    // FAQ und Datenschutzerklaerung nicht auseinanderlaufen. Die Fristen stehen
    // dahinter, weil sie aus Paragraf 7 der Erklaerung stammen (v2.2).
    antwort:
      `${DATENRESIDENZ.text} Alle Übertragungen sind verschlüsselt. Audioaufzeichnungen und ` +
      'Transkripte werden nach 90 Tagen gelöscht, Anrufdaten nach 180 Tagen. Voxera richtet ' +
      'sich nach dem Schweizer Datenschutzgesetz (revDSG) und, soweit anwendbar, der DSGVO.',
    link: { href: '/datenschutz', text: 'Zur Datenschutzerklärung' },
  },
  {
    frage: 'Wie lange dauert die Einrichtung?',
    antwort:
      `${EINRICHTUNG.gespraech.kurz} ${EINRICHTUNG.gespraech.lang} ` +
      `${EINRICHTUNG.dauer.aussage} ${EINRICHTUNG.dauer.abgrenzung}`,
    link: { href: '/so-funktionierts/', text: 'Ablauf im Detail' },
  },
  {
    frage: 'An wen wende ich mich, wenn etwas ist?',
    antwort:
      `${EINRICHTUNG.support.wegErst} ${EINRICHTUNG.support.telefonisch} ` +
      `${EINRICHTUNG.support.hinweis}`,
  },
  {
    frage: 'Kann ich jederzeit kündigen?',
    antwort:
      'Monatspläne sind monatlich kündbar mit 30 Tagen Frist, ohne Mindestlaufzeit. Jahrespläne laufen 12 Monate und verlängern sich automatisch, wenn Sie nicht 30 Tage vor Ablauf kündigen.',
  },
  {
    frage: 'Was ist der Unterschied zu einem Anrufbeantworter?',
    antwort:
      'Ein Anrufbeantworter nimmt auf — Voxera führt ein Gespräch. Lara stellt Rückfragen, erkennt das Anliegen, erfasst die Angaben, die Sie für eine Einschätzung brauchen, und markiert Dringendes als dringend. Statt einer Nachricht, die Sie abhören und selbst einordnen müssen, steht die Anfrage strukturiert im Dashboard.',
  },
];

const beantwortet = FRAGEN.filter((f) => !('gesperrt' in f));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: beantwortet.map((f) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  })),
};
---
<Base
  titel="Häufige Fragen zum KI-Telefonassistenten | Voxera"
  beschreibung="Antworten zu Gesprächsführung, Rufweiterleitung, Datenschutz und Kündigung – kurz, ohne Fachjargon und ohne Kleingedrucktes."
  schema={schema}
>
  <section class="sektion">
    <div class="wrap">
      <hr class="akzentlinie" />
      <h1>Häufige Fragen</h1>

      <dl class="faq">
        {FRAGEN.map((f) => (
          <div class="eintrag">
            <dt>{f.frage}</dt>
            <dd>
              {'gesperrt' in f ? (
                <Platzhalter
                  was="Antwort zur KI-Kennzeichnung am Gesprächsanfang"
                  befund={f.gesperrt.befund}
                  wartetAuf={f.gesperrt.wartetAuf}
                />
              ) : (
                <>
                  {f.antwort}
                  {f.link && <><br /><a href={f.link.href}>{f.link.text}</a></>}
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>

      {/* Der gesonderte C8-Block ist entfallen: Einrichtungsdauer und Support
          stehen jetzt als regulaere Fragen in der Liste oben und damit auch im
          FAQPage-Schema. Ein zweiter Abschnitt zur selben Frage waere eine
          weitere Stelle, an der dieselbe Zusage abweichen kann. */}
      <ul role="list" class="konditionen leise klein">
        {KONDITIONEN.map((k) => <li>{k}</li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .faq { margin-top: 32px; max-width: var(--vx-measure); }
  .eintrag + .eintrag { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--vx-hairline); }
  .faq dt { font-weight: 700; font-size: var(--vx-text-lg); }
  .faq dd { margin: 10px 0 0; }
  h2 { margin-top: 56px; }
  .konditionen { margin-top: 40px; padding: 0; list-style: none; display: grid; gap: 6px; }
  .klein { font-size: 13px; }
</style>
