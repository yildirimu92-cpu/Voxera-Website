---
import Base from '../layouts/Base.astro';
import { BRANCHEN_SICHTBAR } from '../config/site';
import { PLAENE } from '../config/preise';
import { EINRICHTUNG } from '../config/einrichtung';
import { DATENRESIDENZ } from '../config/datenresidenz';

const guenstigster = Math.min(...PLAENE.map((p) => p.monatlichChf));
---
<Base
  titel="KI-Telefonassistent für Schweizer KMU | Voxera"
  beschreibung={`Voxera nimmt Ihre Anrufe entgegen, fasst zusammen und priorisiert – damit Sie keinen Auftrag mehr verpassen. Ab CHF ${guenstigster}/Monat.`}
>
  {/* Kein Hintergrundbild im Hero. Typografie plus ein Produkt-Screenshot ist
      bei einer hellen Richtung der staerkere Einstieg und die beste
      Ausgangslage fuer den LCP-Wert (Zielbild C.1). */}
  <section class="sektion hero">
    <div class="wrap">
      <hr class="akzentlinie" />
      <h1>Kein Anruf mehr verpasst.<br />Voxera übernimmt.</h1>
      <p class="gross leise">
        Voxera nimmt Ihre Anrufe entgegen, fasst zusammen und priorisiert – damit Sie sich
        auf die Arbeit konzentrieren können, für die Sie gerufen werden.
      </p>
      <p class="aktionen">
        <a class="knopf" href="/demo/">Demo ansehen</a>
        <a class="knopf knopf--sekundaer" href="/preise/">Preise</a>
      </p>
      {/* Nennt die Datenbank, nicht „die Daten". Die alte Seite trug hier
          „ausschliesslich in der Schweiz" — das war nicht knapper, sondern
          falsch, weil Telefonie und Sprachverarbeitung ausserhalb laufen. */}
      <p class="residenz leise klein">{DATENRESIDENZ.badge}</p>
    </div>
  </section>

  <section class="sektion sektion--zurueckgesetzt">
    <div class="wrap">
      <h2>Warum Schweizer KMU Aufträge verlieren</h2>
      {/* Hier standen vier Vergleichszahlen: 62 % / 3.4 h / CHF 4'500 und
          72 % zum Anrufbeantworter (Befund C4). Sie sind gestrichen, nicht
          vertagt. Der Content-Audit haelt fest, dass fuer keine der Zahlen
          eine Quelle dokumentiert ist -- weder auf der Seite noch im
          Fahrplan noch im Repo. Unbelegte quantitative Vergleichsangaben
          sind nach UWG angreifbar.

          Kommt eine zitierfaehige Quelle mit Jahr und Erhebungsbasis dazu,
          gehoert die Zahl samt Fussnote zurueck an diese Stelle. */}
      <p>
        Ein verpasster Anruf ist selten nur ein verpasster Anruf. Wer nicht
        durchkommt, ruft beim Nächsten an – und meldet sich kein zweites Mal.
      </p>
      <p class="leise hinweis">
        Wie oft das passiert, hängt vom Betrieb ab. Voxera setzt dort an, wo
        niemand abnehmen kann: ausserhalb der Bürozeiten, während der Arbeit
        am Kunden, wenn die Leitung besetzt ist.
      </p>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap">
      <h2>Voxera passt zu Ihrer Branche</h2>
      <p class="leise">
        Der Assistent kennt die typischen Anliegen Ihrer Branche – und stellt die Rückfragen,
        die Sie sonst selbst stellen würden.
      </p>
      <ul role="list" class="branchen">
        {BRANCHEN_SICHTBAR.map((b) => (
          <li>
            <a class="karte" href={`/branchen/${b.slug}/`}>
              <h3>{b.titel}</h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Sand: genau EINE Flaeche pro Seite. Hier ist sie. */}
  <section class="sektion sektion--warm">
    <div class="wrap">
      {/* Fuehrt mit dem Gespraech, nicht mit der Dauer. Die Geschwindigkeit ist
          die Achse, auf der nutzungsbasierte Anbieter antreten; die 24 Stunden
          stehen deshalb als Folge des Gespraechs, nicht als Versprechen fuer
          sich. Quelle der Zusage: src/config/einrichtung.ts (Befund C8). */}
      <h2>{EINRICHTUNG.gespraech.titel}: wir richten Voxera mit Ihnen ein</h2>
      <p class="gross leise">{EINRICHTUNG.gespraech.kurz}</p>
      <p>{EINRICHTUNG.gespraech.lang}</p>
      <p class="leise hinweis">
        {EINRICHTUNG.dauer.aussage} {EINRICHTUNG.dauer.abgrenzung}
      </p>
      <p class="aktionen">
        <a class="knopf" href="/demo/">Onboarding-Call vereinbaren</a>
        <a class="knopf knopf--sekundaer" href="/so-funktionierts/">So funktioniert's</a>
      </p>
    </div>
  </section>

  {/* Kein Testimonial-Block. Es gibt keine freigegebenen Kundenstimmen — die
      alte Seite trug drei ungedeckte (C16). Vertrauen entsteht hier ueber
      Demo, Ablauf, Preise und Rechtsrahmen. */}
</Base>

<script>
  // Die alte Seite war ein One-Pager; ihre Anker stehen in E-Mails und
  // Offerten. Fragmente erreichen den Server nie, deshalb hier clientseitig.
  const ZIELE = {
    '#wie': '/so-funktionierts/',
    '#features': '/so-funktionierts/',
    '#preise': '/preise/',
    '#pricing': '/preise/',
    '#branchen': '/branchen/',
    '#beratung': '/demo/',
    '#demo': '/demo/',
    '#kontakt': '/kontakt/',
    '#faq': '/faq/',
  };
  const ziel = ZIELE[location.hash];
  if (ziel) location.replace(ziel);
</script>

<style>
  .hero { padding-block: clamp(56px, 9vw, 120px) var(--vx-section-y); }
  .gross { font-size: var(--vx-text-lg); }
  .residenz { margin-top: 20px; }
  .klein { font-size: 13px; }
  .aktionen { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hinweis { margin-top: 16px; font-size: var(--vx-text-sm); }
  .branchen {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin-top: 32px;
    list-style: none;
    padding: 0;
  }
  .branchen a { display: block; text-decoration: none; color: inherit; transition: border-color var(--vx-motion); }
  .branchen a:hover { border-color: var(--vx-hairline-firm); }
  .branchen h3 { font-size: var(--vx-text-base); }
</style>
